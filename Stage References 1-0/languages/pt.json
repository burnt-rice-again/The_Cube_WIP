	"Pause Game": "Pausar jogo",
	"Pauses the game": "Pausa o jogo.",
	"In Game Menu": "Menu do jogo",
	"Opens the in-game menu": "Abre o menu do jogo.",
	"Opens the building menu": "Abre o menu de construção.",
	"Tech Tree": "Árvore Tecnológica",
