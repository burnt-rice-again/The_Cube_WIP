{
    "id": "Main",
    "name": "Base Game Data",
    "version_name": "1.0",
    "version_code": 9,
    "author": "The Desynced Team",
    "homepage": "https://www.desyncedgame.com/",
    "description": "Base Desynced game data used by all scenarios except those that want to overwrite the entire game",
    "packages": {
        "Data": {
            "name": "Base Game Data",
            "entry": "data/data.lua",
            "dependencies": [ "Main/UI" ],
            "map_settings": "data/map_settings.lua"
        },
        "UI": {
            "name": "Base Game UI",
            "entry": "ui/ui.lua"
        },
        "FrontEnd": {
            "name": "Base Game FrontEnd",
            "entry": "frontend/frontend.lua",
            "dependencies": [ "Main/Data" ],
            "type": "Scenario"
        },
        "Credits": {
            "name": "Base Game Credits",
            "entry": "credits/credits.lua",
            "dependencies": [ "Main/Data" ],
            "type": "Scenario"
        },
        "Freeplay": {
            "name": "Freeplay",
            "entry": "scenarios/freeplay.lua",
            "description": "In the multiplayer game mode 'Separate/Versus' every joining player gets their own faction while in 'Shared/Coop' all players will join the main player faction.",
            "dependencies": [ "Main/Data" ],
            "type": "Scenario",
            "modes": [ "Shared/Coop", "Separate/Versus" ]
        },
        "Versus": {
            "name": "Versus",
            "entry": "scenarios/versus.lua",
            "dependencies": [ "Main/Data" ],
            "no_map_settings": true,
            "no_map_preview": true,
            "type": "Scenario"
        },
        "Resim": {
            "name": "Re-Simulator",
            "entry": "scenarios/resimulator.lua",
            "description": "Freeplay with a Challenge for building the resimulator",
            "dependencies": [ "Main/Freeplay" ],
            "no_map_settings": true,
            "type": "Challenge"
        },
        "Registers1": {
            "name": "Register 1",
            "entry": "scenarios/registers1.lua",
            "description": "Store 50 Reinforced Plates by setting registers",
            "dependencies": [ "Main/Data" ],
            "no_map_settings": true,
            "type": "Challenge"
        },
        "Registers2": {
            "name": "Register 2",
            "entry": "scenarios/registers2.lua",
            "description": "Store 50 High Density Frames by setting registers",
            "dependencies": [ "Main/Data" ],
            "no_map_settings": true,
            "type": "Challenge"
        },
        "Signals": {
            "name": "Signal",
            "entry": "scenarios/signals1.lua",
            "description": "Deliver requested ingredients automatically",
            "dependencies": [ "Main/Data" ],
            "no_map_settings": true,
            "type": "Challenge"
        },
        "Nomad": {
            "name": "Nomad",
            "entry": "scenarios/nomad1.lua",
            "description": "Store 50 High Density Frames without constructing buildings",
            "dependencies": [ "Main/Data" ],
            "no_map_settings": true,
            "type": "Challenge"
        },
        "TowerD": {
            "name": "Tower Defense",
            "entry": "scenarios/towerdefense.lua",
            "description": "The bugs are here to eat your silica\nDefend it at all costs !!!",
            "dependencies": [ "Main/Data" ],
            "no_map_settings": true,
            "type": "Scenario"
        },
        "Languages": {
            "name": "Languages",
            "languagesdir": "languages",
            "type": "Translation",
            "languages": {
                "en": "English (American)",
                "es": "Spanish (Spain)",
                "cs": "Czech",
                "de": "German",
                "fr": "French",
                "ja": "Japanese",
                "ko": "Korean",
                "pl": "Polish",
                "pt": "Portugese (Brazil)",
                "ru": "Russian",
                "zh":"Chinese (Simplified)",
                "zh_tw": "Chinese (Traditional)"
            }
        }
    }
}